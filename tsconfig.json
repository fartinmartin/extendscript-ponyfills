{
	"compilerOptions": {
		"target": "ES3",
		"ignoreDeprecations": "5.0",
		"module": "ESNext",
		"declaration": true,
		"declarationMap": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"moduleResolution": "bundler",
		"lib": ["ES2015"],
	},
	"include": ["src/**/*"],
}
